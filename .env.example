# Copy this file to .env and replace placeholder values before starting the app.
SECRET_KEY=replace-with-a-long-random-secret
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Local defaults; Docker Compose overrides DATABASE_URL for the backend service.
DATABASE_URL=mongodb://localhost:27017
DATABASE_NAME=studycompanion

# Optional Hindsight integration. Leave the API key blank to use Mongo fallback.
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_PIPELINE_ID=
HINDSIGHT_API_LLM_MODEL=gpt-oss-20b
HINDSIGHT_API_LLM_API_KEY=

# Comma-separated browser origins allowed by FastAPI.
CORS_ORIGINS=http://localhost:3000,http://localhost:8001

# Browser-side frontend API URL.
NEXT_PUBLIC_API_URL=http://localhost:8001
